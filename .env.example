# Copy this file to .env, then run ./setup.sh to sync it into every workspace.
# Re-run ./setup.sh whenever you change a value here.

# Postgres. Port 5433 matches the mapping in docker-compose.yml — it is
# deliberately not 5432, so a Postgres already installed on your machine
# does not collide with the container.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/dev

# API server
PORT=8000
BASE_URL=http://localhost:8000

# Where the web app reaches the API. This must be an absolute URL: it is used
# during server-side rendering, where Node cannot resolve a relative path.
NEXT_PUBLIC_API_URL=http://localhost:8000/trpc

# error | info | debug — defaults to debug in development, error otherwise.
# LOGGER_LEVEL=debug
