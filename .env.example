# Copy this file to .env, then run ./setup.sh to sync it into every workspace.
# Re-run ./setup.sh whenever you change a value here.

# Postgres. Port 5433 matches the mapping in docker-compose.yml — it is
# deliberately not 5432, so a Postgres already installed on your machine
# does not collide with the container.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/dev

# API server
PORT=8000
BASE_URL=http://localhost:8000

# Where the web app reaches the API. This must be an absolute URL: it is used
# during server-side rendering, where Node cannot resolve a relative path.
#
# In production this must point at the WEB app's own origin, not the API's -
# e.g. https://your-web-app.vercel.app/trpc. The auth cookie is only accepted by
# browsers when it comes from the same site the user is on, so requests are
# proxied through the web app (see apps/web/next.config.js) instead of hitting
# the API host directly. Locally the two are same-site already, so this points
# straight at the API.
NEXT_PUBLIC_API_URL=http://localhost:8000/trpc

# Production only: the real origin of the API, which the proxy above forwards to
# (e.g. https://your-api.up.railway.app). Leave unset locally - without it the
# rewrite is skipped and the web app calls NEXT_PUBLIC_API_URL directly.
# API_ORIGIN=

# Google OAuth & Auth (Replace with actual credentials in production)
GOOGLE_OAUTH_CLIENT_ID=mock-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=mock-google-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
JWT_SECRET=development-jwt-secret-key-change-in-production

# error | info | debug — defaults to debug in development, error otherwise.
# LOGGER_LEVEL=debug
